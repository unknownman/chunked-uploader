{
    "name": "resumable/chunked-uploader",
    "description": "Enterprise-grade, framework-agnostic PHP library for handling large file uploads via chunking with stream-based assembly, resume capability, and cryptographic integrity checks.",
    "homepage": "https://github.com/resumable/chunked-uploader",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "chunked-upload",
        "resumable-upload",
        "file-upload",
        "streams",
        "stream-assembly",
        "laravel",
        "symfony",
        "php8",
        "s3",
        "redis"
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "aws/aws-sdk-php": "^3.300",
        "illuminate/console": "^10.0 || ^11.0",
        "illuminate/contracts": "^10.0 || ^11.0",
        "illuminate/support": "^10.0 || ^11.0",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "predis/predis": "^2.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan": "^1.12"
    },
    "suggest": {
        "ext-redis": "Required for RedisMetadataRepository with native Redis client.",
        "predis/predis": "Alternative Redis client for RedisMetadataRepository.",
        "ext-pdo": "Required for PdoMetadataRepository.",
        "aws/aws-sdk-php": "Required for S3ChunkStorage.",
        "league/flysystem": "Required for optional Flysystem storage bridge."
    },
    "autoload": {
        "psr-4": {
            "Resumable\\ChunkedUploader\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Resumable\\ChunkedUploader\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/resumable/chunked-uploader/issues",
        "source": "https://github.com/resumable/chunked-uploader"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Resumable\\ChunkedUploader\\Bridge\\Laravel\\Providers\\ChunkUploaderServiceProvider"
            ],
            "aliases": {
                "ChunkUploader": "Resumable\\ChunkedUploader\\Bridge\\Laravel\\Facades\\ChunkUploader"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
